# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Supabase (backend + scripts) ---
# Project Settings -> API. The secret/service-role key stays backend-only.
SUPABASE_URL=https://nmnaehjgxqrfsbccvvqq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://nmnaehjgxqrfsbccvvqq.supabase.co/auth/v1/.well-known/jwks.json
# Legacy name supported for existing local environments:
SUPABASE_KEY=your-supabase-service-role-key

# --- Gemini (backend only — never expose this in the frontend) ---
GEMINI_API_KEY=your-gemini-api-key

# --- Backend tuning (optional — defaults live in backend/app/config.py) ---
ZONE_LATE_RATIO_THRESHOLD=0.30
RIDER_DETOUR_RATIO_THRESHOLD=1.6
RIDER_STATIONARY_MINUTES_THRESHOLD=8.0
RIDER_DROPOFF_DISTANCE_THRESHOLD_M=150.0
AGGREGATOR_CONFIDENCE_THRESHOLD=0.6
CORS_ORIGINS=http://localhost:5173

# --- Frontend (Vite reads these — copy the relevant ones into frontend/.env) ---
# Use the Supabase ANON key here, not the service role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000
