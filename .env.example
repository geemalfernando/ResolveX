# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Supabase (backend + scripts) ---
# Project Settings -> API. The secret/service-role key stays backend-only.
SUPABASE_URL=https://nmnaehjgxqrfsbccvvqq.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://nmnaehjgxqrfsbccvvqq.supabase.co/auth/v1/.well-known/jwks.json
# Legacy name supported for existing local environments:
SUPABASE_KEY=your-supabase-service-role-key

# --- Gemini (backend only — never expose this in the frontend) ---
GEMINI_API_KEY=your-gemini-api-key
# Set false when tokens/quota fail so CLAIM HISTORY / route / timing still decide
PHOTO_USE_GEMINI=true
AGGREGATOR_USE_GEMINI=true

# --- Backend tuning (optional — defaults live in backend/app/config.py) ---
ZONE_LATE_RATIO_THRESHOLD=0.30
RIDER_DETOUR_RATIO_THRESHOLD=1.6
RIDER_STATIONARY_MINUTES_THRESHOLD=8.0
RIDER_DROPOFF_DISTANCE_THRESHOLD_M=150.0
AGGREGATOR_CONFIDENCE_THRESHOLD=0.6
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Matches preview hostnames that change every build. Localhost is always allowed.
# Firebase example: https://PROJECT_ID(--[a-z0-9-]+)?\.web\.app|https://PROJECT_ID\.firebaseapp\.com
CORS_ORIGIN_REGEX=
# The ops demo feed needs a long-lived server; it is skipped automatically on Vercel.
ENABLE_DEMO_WORKER=true

# --- Frontend (Vite reads these — copy the relevant ones into frontend/.env) ---
# Use the Supabase ANON key here, not the service role key.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_BASE_URL=http://localhost:8000

# Resolution thresholds (fault model probabilities remain unchanged)
SUPPORT_REVIEW_CONFIDENCE_THRESHOLD=0.55
AUTO_ACTION_CONFIDENCE_THRESHOLD=0.85
# Claim-history AI: below this risk, refund automatically; at/above it, admin refunds manually.
CLAIM_HISTORY_AUTO_REFUND_THRESHOLD=0.40
